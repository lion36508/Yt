<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nexora_wallpaper">

    <!-- ========================================================= -->
    <!-- PAGE 1: HOME (STREAMER, FULL-WIDTH PLAYER & 3-DOT DL)     -->
    <!-- ========================================================= -->
    <ScrollView
        android:id="@+id/pageHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- 1. TOP PLATFORM TABS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:id="@+id/btnAllInOneHub"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15"
                    android:background="@drawable/chip_active"
                    android:gravity="center"
                    android:layout_marginRight="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ALL MIX"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="9.5sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabYoutube"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:background="@drawable/frame_slate_pill"
                    android:gravity="center"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_marginRight="4dp">
                    <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/vec_play" android:layout_marginRight="3dp"/>
                    <TextView android:id="@+id/txtTabYt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YouTube" android:textColor="#FFFFFF" android:textSize="9sp" android:singleLine="true"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabInsta"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:background="@drawable/frame_slate_pill"
                    android:gravity="center"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_marginRight="4dp">
                    <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_instagram" android:layout_marginRight="3dp"/>
                    <TextView android:id="@+id/txtTabIg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Insta/FB" android:textColor="#D0D8E8" android:textSize="9sp" android:singleLine="true"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabTiktok"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15"
                    android:background="@drawable/frame_slate_pill"
                    android:gravity="center"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_marginRight="4dp">
                    <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_tiktok" android:layout_marginRight="3dp"/>
                    <TextView android:id="@+id/txtTabTk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TikTok" android:textColor="#D0D8E8" android:textSize="9sp" android:singleLine="true"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabX"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.85"
                    android:background="@drawable/frame_slate_pill"
                    android:gravity="center">
                    <TextView android:id="@+id/txtTabX" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="𝕏" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 2A. UPPER BAR: DIRECT LINK LOAD BAR (NO DUPLICATE DOWNLOAD BUTTON) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:id="@+id/boxUrlBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/frame_search_bar"
                    android:gravity="center_vertical"
                    android:paddingLeft="12dp"
                    android:paddingRight="10dp"
                    android:layout_marginRight="8dp">

                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/vec_link" android:layout_marginRight="8dp"/>

                    <EditText
                        android:id="@+id/etUrl"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#00000000"
                        android:hint="Paste video URL here to play..."
                        android:textColorHint="#5C7499"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:singleLine="true"/>

                    <TextView
                        android:id="@+id/btnClearUrl"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/circle_play_bg"
                        android:text="✕"
                        android:textColor="#90A4AE"
                        android:textSize="9sp"
                        android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnFetchVideo"
                    android:layout_width="54dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/chip_active"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOAD"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="9.5sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 2B. LOWER BAR: KEYWORD VIDEO SEARCH BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/boxSearchBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/frame_slate_pill"
                    android:gravity="center_vertical"
                    android:paddingLeft="12dp"
                    android:paddingRight="10dp"
                    android:layout_marginRight="8dp">

                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/vec_search" android:layout_marginRight="8dp"/>

                    <EditText
                        android:id="@+id/etVideoSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#00000000"
                        android:hint="Search songs, movies, gaming, TikTok, Reels..."
                        android:textColorHint="#6C829E"
                        android:textColor="#00B0FF"
                        android:textSize="11.5sp"
                        android:singleLine="true"/>

                    <TextView
                        android:id="@+id/btnClearSearch"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/circle_play_bg"
                        android:text="✕"
                        android:textColor="#90A4AE"
                        android:textSize="9sp"
                        android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSearchVideos"
                    android:layout_width="54dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/chip_active"
                    android:gravity="center">
                    <ImageView android:layout_width="19dp" android:layout_height="19dp" android:src="@drawable/vec_search"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 3. FULL-SCREEN WIDTH VIDEO PLAYER (SIDE DOWNLOAD PANEL REMOVED!) -->
            <RelativeLayout
                android:id="@+id/playerContainerBox"
                android:layout_width="match_parent"
                android:layout_height="215dp"
                android:background="@drawable/frame_neon_blue"
                android:padding="2dp"
                android:layout_marginBottom="6dp">

                <VideoView
                    android:id="@+id/realVideoView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true" />

                <ImageView
                    android:id="@+id/ivPlayerPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/tvQualityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="READY"
                    android:textColor="#00E5FF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/frame_icon_slot"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_margin="8dp"/>

                <LinearLayout
                    android:id="@+id/btnCenterPlay"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/circle_play_bg"
                    android:gravity="center"
                    android:layout_centerInParent="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/vec_play" android:layout_marginLeft="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/playerBottomBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:background="#CC03060C"
                    android:gravity="center_vertical"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tvCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"/>

                    <SeekBar
                        android:id="@+id/playerSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="0"/>

                    <TextView
                        android:id="@+id/tvTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#00E5FF"
                        android:textSize="9sp"
                        android:layout_marginRight="8dp"/>

                    <ImageView
                        android:id="@+id/btnFullscreen"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/vec_fullscreen"/>
                </LinearLayout>
                <FrameLayout
        android:id="@+id/fullscreenHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</RelativeLayout>

            <!-- 4. PLAYER ACTION BAR WITH DOWNLOAD + 3-DOT (⋮) FORMAT/QUALITY MENU -->
            <LinearLayout
                android:id="@+id/boxActionButtons"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/frame_slate_pill"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_marginBottom="8dp">

                <LinearLayout android:id="@+id/actPlay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <LinearLayout android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/frame_icon_slot" android:gravity="center">
                        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/vec_play"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Play/Pause" android:textColor="#2196F3" android:textSize="7sp" android:layout_marginTop="1dp"/>
                </LinearLayout>

                <!-- Main Download Button + 3-Dot (⋮) Format & Quality Selector right next to it -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.55"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/frame_icon_slot"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="4dp">

                    <LinearLayout
                        android:id="@+id/actDownload"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/vec_download" android:layout_marginRight="4dp"/>
                        <TextView android:id="@+id/tvSelectedFormatBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Download" android:textColor="#00E5FF" android:textStyle="bold" android:textSize="8.5sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnDownloadThreeDots"
                        android:layout_width="28dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="⋮"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:background="@drawable/chip_active"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/actShare" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <LinearLayout android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/frame_icon_slot" android:gravity="center">
                        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/vec_share"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Share" android:textColor="#2196F3" android:textSize="7sp" android:layout_marginTop="1dp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/actPip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <LinearLayout android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/frame_icon_slot" android:gravity="center">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/vec_pip"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PIP Mode" android:textColor="#2196F3" android:textSize="7sp" android:layout_marginTop="1dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 5. ACTIVE VIDEO INFO & SPEED BAR -->
            <LinearLayout
                android:id="@+id/boxInfoBar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/frame_slate_pill"
                android:gravity="center_vertical"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/circle_avatar"
                    android:gravity="center"
                    android:layout_marginRight="8dp">
                    <TextView android:id="@+id/tvPlatformBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MIX" android:textColor="#00B0FF" android:textSize="8sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvActiveTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap any video below to stream or download"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:singleLine="true"/>
                    <TextView
                        android:id="@+id/tvActiveSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap ⋮ next to Download to choose Video/Audio format"
                        android:textColor="#00B0FF"
                        android:textSize="8sp"
                        android:singleLine="true"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnMediaPrev"
                    android:layout_width="28dp"
                    android:layout_height="26dp"
                    android:background="@drawable/frame_icon_slot"
                    android:text="⏮"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginRight="4dp"/>

                <TextView
                    android:id="@+id/btnMediaNext"
                    android:layout_width="28dp"
                    android:layout_height="26dp"
                    android:background="@drawable/frame_icon_slot"
                    android:text="⏭"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginRight="4dp"/>

                <TextView
                    android:id="@+id/btnSpeedControl"
                    android:layout_width="42dp"
                    android:layout_height="26dp"
                    android:background="@drawable/btn_subscribe"
                    android:text="1.0x"
                    android:textColor="#FFFFFF"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- 6. CATEGORY CHIPS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView android:id="@+id/chipRec" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.35" android:background="@drawable/chip_active" android:text="All Mixed" android:textColor="#FFFFFF" android:textSize="8.5sp" android:textStyle="bold" android:gravity="center" android:singleLine="true" android:layout_marginRight="4dp"/>
                <TextView android:id="@+id/chipTrend" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/chip_inactive" android:text="Trending" android:textColor="#2196F3" android:textSize="8.5sp" android:gravity="center" android:singleLine="true" android:layout_marginRight="4dp"/>
                <TextView android:id="@+id/chipMusic" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.85" android:background="@drawable/chip_inactive" android:text="Music" android:textColor="#2196F3" android:textSize="8.5sp" android:gravity="center" android:singleLine="true" android:layout_marginRight="4dp"/>
                <TextView android:id="@+id/chipGaming" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.95" android:background="@drawable/chip_inactive" android:text="Gaming" android:textColor="#2196F3" android:textSize="8.5sp" android:gravity="center" android:singleLine="true" android:layout_marginRight="4dp"/>
                <TextView android:id="@+id/chipNews" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.85" android:background="@drawable/chip_inactive" android:text="News" android:textColor="#2196F3" android:textSize="8.5sp" android:gravity="center" android:singleLine="true" android:layout_marginRight="4dp"/>
                <TextView android:id="@+id/chipShorts" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.95" android:background="@drawable/chip_inactive" android:text="Reels/TikTok" android:textColor="#2196F3" android:textSize="8.5sp" android:gravity="center" android:singleLine="true"/>
            </LinearLayout>

            <!-- 7. INFINITE LOOP ROW 1 -->
            <HorizontalScrollView
                android:id="@+id/hsvRow1"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:scrollbars="none"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/row1Container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 8. INFINITE LOOP ROW 2 -->
            <HorizontalScrollView
                android:id="@+id/hsvRow2"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:scrollbars="none"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:id="@+id/row2Container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- ========================================================= -->
    <!-- PAGE 2: DEDICATED DOWNLOADS MANAGER PAGE                  -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/pageDownloads"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/frame_slate_pill"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_marginBottom="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⬇ NEXORA Downloads Manager"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvActiveDownloadStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Idle"
                android:textColor="#00C853"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:id="@+id/downloadsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- ========================================================= -->
    <!-- PAGE 3: MX PLAYER / PHONE GALLERY PAGE (ALL PHONE VIDEOS) -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/pageGallery"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/frame_slate_pill"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_marginBottom="10dp">
            <TextView
                android:id="@+id/tvGalleryHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎬 Phone Video Gallery (MX Style)"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/btnRescanGallery"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/chip_active"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="🔄 Scan Phone"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:id="@+id/galleryListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- ========================================================= -->
    <!-- PAGE 4: DEDICATED FULL-SCREEN SETTINGS PAGE               -->
    <!-- ========================================================= -->
    <ScrollView
        android:id="@+id/pageSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settingsContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- 9. BOTTOM NAVIGATION BAR (SWITCHES BETWEEN THE 4 PAGES) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/frame_download_panel"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="6dp">

        <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
