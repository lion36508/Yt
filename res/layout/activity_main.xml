<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050510">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/welcome_banner"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44000000" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">
        
        <TextView
            android:id="@+id/langSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐 English / 中文 ﹀"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/lang_bg"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>
            
        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skip ➔"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:gravity="center_horizontal"
        android:padding="20dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UQ Video Downloader"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Download Videos from Anywhere\nFast • Free • Powerful"
            android:textColor="#DDDDDD"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4"
            android:layout_marginBottom="40dp">
            
            <LinearLayout android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/box_bg" android:layout_margin="4dp" android:gravity="center">
                <TextView android:text="⚡" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Ultra Fast\n极速下载" android:textColor="#FFF" android:textSize="10sp" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/box_bg" android:layout_margin="4dp" android:gravity="center">
                <TextView android:text="🛡️" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="High Quality\n高画质" android:textColor="#FFF" android:textSize="10sp" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/box_bg" android:layout_margin="4dp" android:gravity="center">
                <TextView android:text="▶️" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Multi App\n多平台" android:textColor="#FFF" android:textSize="10sp" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/box_bg" android:layout_margin="4dp" android:gravity="center">
                <TextView android:text="📁" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Easy to Use\n简单易用" android:textColor="#FFF" android:textSize="10sp" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Get Started  ➔"
            android:textColor="#000000"
            android:background="@drawable/btn_bg"
            android:foreground="?android:attr/selectableItemBackground"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false"/>
            
    </LinearLayout>
</RelativeLayout>
